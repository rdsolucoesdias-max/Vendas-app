<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#1a1a2e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="VendasPRO">
<title>VendasPRO</title>
<style>
:root{
  --bg:#0f0f1a;--bg2:#1a1a2e;--bg3:#16213e;--card:#1e1e3a;--card2:#252545;
  --accent:#7c3aed;--accent2:#a855f7;--green:#10b981;--red:#ef4444;
  --blue:#3b82f6;--yellow:#f59e0b;--text:#f1f5f9;--text2:#94a3b8;
  --text3:#64748b;--border:#2d2d5e;--border2:#3d3d7e;--wpp:#25d366;
  --radius:14px;--shadow:0 4px 24px rgba(0,0,0,.4);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text)}
#app{height:100%;display:flex;flex-direction:column;overflow:hidden}
.screen{display:none;flex:1;flex-direction:column;overflow:hidden}
.screen.active{display:flex}

/* LOADING */
#loadingOverlay{position:fixed;inset:0;background:rgba(15,15,26,.95);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}
#loadingOverlay.hidden{display:none}
.spinner{width:48px;height:48px;border:4px solid var(--border);border-top-color:var(--accent2);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{color:var(--text2);font-size:14px;font-weight:600}

/* CONFIG SCREEN */
#configScreen{background:linear-gradient(135deg,#0f0f1a,#1a1a2e,#16213e);align-items:center;justify-content:center;padding:24px}
.config-box{width:100%;max-width:420px;background:var(--card);border-radius:24px;padding:32px 24px;border:1px solid var(--border)}
.config-box h1{font-size:22px;font-weight:800;margin-bottom:6px;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.config-box p{font-size:13px;color:var(--text2);margin-bottom:20px;line-height:1.6}
.config-step{background:var(--bg2);border-radius:10px;padding:12px;margin-bottom:12px;font-size:13px;border:1px solid var(--border)}
.config-step strong{color:var(--accent2);display:block;margin-bottom:4px}
.config-step code{background:var(--bg);border-radius:4px;padding:2px 6px;font-size:12px;color:var(--green)}

/* LOGIN */
#loginScreen{background:linear-gradient(135deg,#0f0f1a,#1a1a2e,#16213e);align-items:center;justify-content:center;padding:24px}
.login-box{width:100%;max-width:400px;background:var(--card);border-radius:24px;padding:36px 28px;box-shadow:var(--shadow);border:1px solid var(--border)}
.login-logo{text-align:center;margin-bottom:28px}
.login-logo-canvas{width:80px;height:80px;border-radius:20px;margin-bottom:12px}
.login-logo img{width:80px;height:80px;border-radius:20px;object-fit:cover;margin-bottom:12px}
.login-logo h1{font-size:26px;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.login-logo p{color:var(--text2);font-size:13px;margin-top:4px}
.tab-switch{display:flex;background:var(--bg2);border-radius:10px;padding:4px;margin-bottom:24px;gap:4px}
.tab-switch button{flex:1;padding:10px;border:none;background:transparent;color:var(--text2);border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:.2s}
.tab-switch button.active{background:var(--accent);color:#fff}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-size:12px;font-weight:600;color:var(--text2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:13px 16px;background:var(--bg2);border:1.5px solid var(--border);border-radius:10px;color:var(--text);font-size:15px;outline:none;transition:.2s}
.form-group input:focus,.form-group select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,58,237,.15)}
.form-group input::placeholder{color:var(--text3)}
.form-group textarea{resize:vertical;min-height:80px}
.form-group select option{background:var(--card)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 20px;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;transition:.2s;text-decoration:none;white-space:nowrap}
.btn:active{transform:scale(.97)}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;width:100%}
.btn-success{background:var(--green);color:#fff}
.btn-danger{background:var(--red);color:#fff}
.btn-outline{background:transparent;border:1.5px solid var(--border2);color:var(--text)}
.btn-ghost{background:transparent;color:var(--text2)}
.btn-wpp{background:var(--wpp);color:#fff}
.btn-sm{padding:8px 14px;font-size:13px;border-radius:8px}
.btn-xs{padding:5px 10px;font-size:12px;border-radius:6px}
.btn-icon{width:40px;height:40px;padding:0;border-radius:10px}
.btn-lg{padding:16px 24px;font-size:16px;border-radius:12px}

/* HEADER */
.header{display:flex;align-items:center;padding:16px 20px;gap:12px;border-bottom:1px solid var(--border);background:var(--bg2);min-height:64px;flex-shrink:0}
.header-logo{width:36px;height:36px;border-radius:10px;object-fit:cover;flex-shrink:0}
.header-logo-canvas{width:36px;height:36px;border-radius:10px;flex-shrink:0}
.header-title{flex:1}
.header-title h2{font-size:17px;font-weight:700;line-height:1.2}
.header-title span{font-size:12px;color:var(--text2)}
.header-actions{display:flex;gap:8px;align-items:center}

/* BOTTOM NAV */
#bottomNav{display:none;background:var(--bg2);border-top:1px solid var(--border);padding:8px 0;flex-shrink:0}
#bottomNav.visible{display:flex}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 4px;cursor:pointer;color:var(--text3);transition:.2s;border:none;background:transparent}
.nav-item.active{color:var(--accent2)}
.nav-item svg{width:22px;height:22px}
.nav-item span{font-size:10px;font-weight:600}

/* CONTENT */
.content{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.content::-webkit-scrollbar{width:4px}
.content::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
.padded{padding:16px}

/* CARDS */
.card{background:var(--card);border-radius:var(--radius);padding:16px;border:1px solid var(--border);margin-bottom:12px}
.card2{background:var(--card2);border-radius:10px;padding:14px;border:1px solid var(--border)}

/* DASHBOARD */
.greeting{font-size:22px;font-weight:800;margin-bottom:4px}
.greeting span{background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.date-text{color:var(--text2);font-size:13px;margin-bottom:20px}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
.stat-card{background:var(--card);border-radius:var(--radius);padding:16px;border:1px solid var(--border);position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:-20px;right:-20px;width:70px;height:70px;border-radius:50%;opacity:.1}
.stat-card.green::before{background:var(--green)}.stat-card.blue::before{background:var(--blue)}
.stat-card.red::before{background:var(--red)}.stat-card.yellow::before{background:var(--yellow)}
.stat-card .icon{font-size:24px;margin-bottom:8px}
.stat-card .value{font-size:20px;font-weight:800;line-height:1}
.stat-card .label{font-size:11px;color:var(--text2);margin-top:4px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.stat-card .sub{font-size:11px;margin-top:4px;font-weight:600}
.stat-card.green .value{color:var(--green)}.stat-card.blue .value{color:var(--blue)}
.stat-card.red .value{color:var(--red)}.stat-card.yellow .value{color:var(--yellow)}
.section-title{font-size:14px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.new-sale-btn{background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;border-radius:var(--radius);padding:18px;width:100%;display:flex;align-items:center;gap:14px;color:#fff;cursor:pointer;margin-bottom:20px;box-shadow:0 4px 20px rgba(124,58,237,.4);transition:.2s}
.new-sale-btn:active{transform:scale(.98)}
.new-sale-btn .icon{width:48px;height:48px;background:rgba(255,255,255,.2);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.new-sale-btn .text h3{font-size:17px;font-weight:700}
.new-sale-btn .text p{font-size:12px;opacity:.8;margin-top:2px}
.new-sale-btn .arrow{margin-left:auto;font-size:20px;opacity:.7}
.fiado-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);cursor:pointer}
.fiado-item:last-child{border-bottom:none}
.fiado-avatar{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;color:#fff}
.fiado-info{flex:1}
.fiado-name{font-size:15px;font-weight:600}
.fiado-date{font-size:11px;color:var(--text3);margin-top:2px}
.fiado-value{font-size:15px;font-weight:700}
.fiado-value.overdue{color:var(--red)}.fiado-value.ok{color:var(--yellow)}
.sale-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.sale-item:last-child{border-bottom:none}
.sale-badge{padding:4px 8px;border-radius:6px;font-size:11px;font-weight:700;flex-shrink:0}
.sale-badge.vista{background:rgba(16,185,129,.15);color:var(--green)}
.sale-badge.fiado{background:rgba(245,158,11,.15);color:var(--yellow)}
.sale-info{flex:1}
.sale-name{font-size:14px;font-weight:600}
.sale-time{font-size:11px;color:var(--text3)}
.sale-val{font-size:15px;font-weight:700;color:var(--green)}

/* CUSTOMERS */
.search-bar{display:flex;gap:8px;margin-bottom:16px}
.search-bar input{flex:1;padding:12px 16px;background:var(--card);border:1.5px solid var(--border);border-radius:10px;color:var(--text);font-size:15px;outline:none}
.search-bar input:focus{border-color:var(--accent)}
.customer-card{background:var(--card);border-radius:var(--radius);padding:16px;border:1px solid var(--border);margin-bottom:10px;cursor:pointer;transition:.2s}
.customer-card:hover{border-color:var(--accent)}
.customer-header{display:flex;align-items:center;gap:12px}
.cust-avatar{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;flex-shrink:0;color:#fff}
.cust-info{flex:1}
.cust-name{font-size:16px;font-weight:700}
.cust-phone{font-size:12px;color:var(--text2);margin-top:2px}
.cust-balance{font-size:16px;font-weight:700}
.balance-badge{font-size:11px;padding:3px 8px;border-radius:6px;margin-top:4px;display:inline-block;font-weight:600}
.balance-badge.positive{background:rgba(239,68,68,.15);color:var(--red)}
.balance-badge.zero{background:rgba(16,185,129,.15);color:var(--green)}
.due-badge{font-size:11px;padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px;font-weight:600;margin-top:4px}
.due-badge.overdue{background:rgba(239,68,68,.15);color:var(--red)}
.due-badge.soon{background:rgba(245,158,11,.15);color:var(--yellow)}
.due-badge.ok{background:rgba(16,185,129,.15);color:var(--green)}
.cust-actions{display:flex;gap:6px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}
.pill-tabs{display:flex;gap:6px;margin-bottom:16px;overflow-x:auto;padding-bottom:4px}
.pill-tabs::-webkit-scrollbar{display:none}
.pill-tab{padding:8px 16px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--text2);font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:.2s}
.pill-tab.active{background:var(--accent);border-color:var(--accent);color:#fff}

/* CUSTOMER DETAIL */
.customer-detail-header{background:linear-gradient(135deg,var(--accent),var(--accent2));padding:20px;color:#fff}
.cd-avatar{width:64px;height:64px;border-radius:16px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;margin-bottom:12px}
.cd-name{font-size:22px;font-weight:800}
.cd-phone{font-size:14px;opacity:.8;margin-top:4px}
.cd-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:16px}
.cd-stat{background:rgba(255,255,255,.1);border-radius:10px;padding:10px;text-align:center}
.cd-stat .v{font-size:16px;font-weight:700}
.cd-stat .l{font-size:10px;opacity:.7;margin-top:2px}
.purchase-item{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--border)}
.purchase-item:last-child{border-bottom:none}
.pi-icon{width:38px;height:38px;border-radius:10px;background:rgba(124,58,237,.15);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.pi-info{flex:1}
.pi-name{font-size:14px;font-weight:600}
.pi-detail{font-size:12px;color:var(--text2);margin-top:2px}
.pi-val{font-size:15px;font-weight:700}
.pi-val.paid{color:var(--green)}.pi-val.pending{color:var(--yellow)}
.status-chip{font-size:10px;padding:3px 7px;border-radius:5px;font-weight:700;display:inline-block}
.status-chip.pending{background:rgba(245,158,11,.15);color:var(--yellow)}
.status-chip.paid{background:rgba(16,185,129,.15);color:var(--green)}

/* STOCK */
.stock-summary{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:16px}
.stock-stat{background:var(--card);border-radius:10px;padding:12px;border:1px solid var(--border);text-align:center}
.stock-stat .v{font-size:16px;font-weight:700;margin-bottom:4px}
.stock-stat .l{font-size:10px;color:var(--text2);font-weight:600;text-transform:uppercase}
.stock-stat.entrada .v{color:var(--blue)}.stock-stat.esperado .v{color:var(--accent2)}
.stock-stat.atual .v.profit{color:var(--green)}.stock-stat.atual .v.loss{color:var(--red)}.stock-stat.atual .v.break{color:var(--yellow)}
.product-card{background:var(--card);border-radius:var(--radius);padding:16px;border:1px solid var(--border);margin-bottom:10px}
.product-header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.prod-icon{width:44px;height:44px;border-radius:10px;background:rgba(124,58,237,.15);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.prod-info{flex:1}
.prod-name{font-size:16px;font-weight:700}
.prod-cat{font-size:12px;color:var(--text2)}
.prod-vals{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px}
.prod-val{background:var(--bg2);border-radius:8px;padding:8px;text-align:center}
.prod-val .v{font-size:14px;font-weight:700}
.prod-val .l{font-size:10px;color:var(--text2);margin-top:2px}
.prod-val.cost .v{color:var(--blue)}.prod-val.sale .v{color:var(--green)}.prod-val.unit .v{color:var(--accent2)}
.stock-bar{height:6px;background:var(--bg2);border-radius:3px;margin-bottom:8px;overflow:hidden}
.stock-bar-fill{height:100%;border-radius:3px;transition:.5s}
.profit-indicator{display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:8px;margin-bottom:10px}
.profit-indicator.profit{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3)}
.profit-indicator.loss{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3)}
.profit-indicator.break{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3)}
.profit-indicator span{font-size:12px;font-weight:600}
.profit-indicator.profit span{color:var(--green)}.profit-indicator.loss span{color:var(--red)}.profit-indicator.break span{color:var(--yellow)}
.chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600}
.chip.green{background:rgba(16,185,129,.15);color:var(--green)}.chip.red{background:rgba(239,68,68,.15);color:var(--red)}
.chip.yellow{background:rgba(245,158,11,.15);color:var(--yellow)}.chip.purple{background:rgba(124,58,237,.15);color:var(--accent2)}

/* SETTINGS */
.settings-section{margin-bottom:24px}
.settings-section h3{font-size:13px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.logo-upload-area{width:100px;height:100px;border-radius:20px;border:2px dashed var(--border2);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;margin-bottom:16px;position:relative;overflow:hidden;background:var(--bg2)}
.logo-upload-area img{width:100%;height:100%;object-fit:cover;border-radius:18px}
.logo-upload-area .overlay{position:absolute;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;opacity:0;transition:.2s;border-radius:18px}
.logo-upload-area:hover .overlay{opacity:1}
.logo-upload-area .placeholder{font-size:12px;color:var(--text3);text-align:center;padding:8px}
.logo-upload-area .placeholder div{font-size:28px;margin-bottom:4px}
.settings-item{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);cursor:pointer}
.settings-item:last-child{border-bottom:none}
.settings-item-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.settings-item-info{flex:1}
.settings-item-info h4{font-size:15px;font-weight:600}
.settings-item-info p{font-size:12px;color:var(--text2);margin-top:2px}
.ai-logo-section{background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(168,85,247,.1));border:1px solid rgba(124,58,237,.3);border-radius:12px;padding:16px;margin-top:12px}
.ai-logo-section h4{font-size:14px;font-weight:700;color:var(--accent2);margin-bottom:8px}
.ai-logo-section p{font-size:12px;color:var(--text2);margin-bottom:12px;line-height:1.5}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:100;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px)}
.modal-overlay.active{display:flex}
.modal-overlay.center{align-items:center}
.modal{background:var(--bg2);border-radius:24px 24px 0 0;width:100%;max-width:500px;max-height:92vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.modal.center-modal{border-radius:20px;margin:16px;max-height:80vh}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:20px 20px 16px;position:sticky;top:0;background:var(--bg2);z-index:1;border-bottom:1px solid var(--border)}
.modal-header h3{font-size:18px;font-weight:700}
.modal-close{width:32px;height:32px;border-radius:8px;background:var(--card2);border:none;color:var(--text2);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.modal-body{padding:20px}
.modal-footer{padding:16px 20px;border-top:1px solid var(--border);display:flex;gap:8px}

/* SALE FLOW */
.sale-type-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
.sale-type-btn{background:var(--card);border:2px solid var(--border);border-radius:var(--radius);padding:20px 16px;text-align:center;cursor:pointer;transition:.2s}
.sale-type-btn.selected{border-color:var(--accent);background:rgba(124,58,237,.1)}
.sale-type-btn .icon{font-size:32px;margin-bottom:8px}
.sale-type-btn h3{font-size:15px;font-weight:700}
.sale-type-btn p{font-size:12px;color:var(--text2);margin-top:4px}
.pay-method-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}
.pay-method-btn{background:var(--card);border:2px solid var(--border);border-radius:10px;padding:14px 10px;text-align:center;cursor:pointer;transition:.2s}
.pay-method-btn.selected{border-color:var(--accent);background:rgba(124,58,237,.1)}
.pay-method-btn .icon{font-size:24px;margin-bottom:6px}
.pay-method-btn span{font-size:13px;font-weight:600;display:block}
.cart-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}
.cart-item:last-child{border-bottom:none}
.cart-item-info{flex:1}
.cart-item-name{font-size:14px;font-weight:600}
.cart
